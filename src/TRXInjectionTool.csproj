<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);SYSLIB1045</NoWarn>
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\sdk\TRXInjection.Sdk.csproj" />
  </ItemGroup>

  <!-- The builder packs are plugins, but building the host stages them into
       its own Plugins folder so running from the IDE or dotnet run finds
       them without extra steps. -->
  <ItemGroup>
    <ProjectReference Include="..\builders\TR1\TRXBuilders.TR1.csproj;..\builders\TR2\TRXBuilders.TR2.csproj;..\builders\TR3\TRXBuilders.TR3.csproj;..\builders\TR4\TRXBuilders.TR4.csproj;..\builders\TRX\TRXBuilders.TRX.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>BuilderPack</OutputItemType>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="StageBuilderPacks" AfterTargets="Build">
    <Copy SourceFiles="@(BuilderPack)" DestinationFolder="$(OutDir)Plugins" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishBuilderPacks" AfterTargets="Publish">
    <Copy SourceFiles="@(BuilderPack)" DestinationFolder="$(PublishDir)Plugins" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="Resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Published\" />
  </ItemGroup>

</Project>
